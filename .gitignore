.venv/
__pycache__/
*.py[cod]
.DS_Store
.ipynb_checkpoints/

# Data is never committed — see README for how to fetch it.
data/
!data/.gitkeep

# Iceberg tables — these are data, not source.
warehouse/

# Spark local artifacts (created in the working directory at runtime)
spark-warehouse/
metastore_db/
derby.log

# Editable-install build metadata
*.egg-info/

# Generated artifacts
reports/*.png
reports/*.html
wandb/
mlruns/

# Rendered from conf/spark-defaults.conf.template by marketrank.config
# (the warehouse path is environment-dependent; Spark does not interpolate).
conf/spark-defaults.conf

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Regenerable model/export artifacts (marketrank.retrieval.dataset, trained
# checkpoints). Rebuild with `make twotower-data` / `make twotower-train`.
artifacts/
