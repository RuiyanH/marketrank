.venv/
__pycache__/
*.py[cod]
.DS_Store
.ipynb_checkpoints/

# Data is never committed — see README for how to fetch it.
data/
!data/.gitkeep

# Iceberg tables — these are data, not source.
warehouse/

# Spark local artifacts (created in the working directory at runtime)
spark-warehouse/
metastore_db/
derby.log

# Editable-install build metadata
*.egg-info/

# Generated artifacts
reports/*.png
reports/*.html
wandb/
mlruns/

# Rendered from conf/spark-defaults.conf.template by marketrank.config
# (the warehouse path is environment-dependent; Spark does not interpolate).
conf/spark-defaults.conf

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Regenerable model/export artifacts (marketrank.retrieval.dataset, trained
# checkpoints). Rebuild with `make twotower-data` / `make twotower-train`.
#
# EXCEPT the provenance sidecars. `ceiling.json` and `*.meta.json` are a few KB
# each and are NOT regenerable in the sense the parquet is: they record which
# args, cohort and inputs produced a number. The measurements they describe were
# computed on misha, under $HOME/scratch, which is PURGED AFTER 60 DAYS -- so
# without this the only audit trail for the 11.930% ceiling has a deletion date.
#
# Written as `artifacts/**` rather than `artifacts/`, deliberately: git does not
# descend into an excluded DIRECTORY, so `!artifacts/**/ceiling.json` under a
# bare `artifacts/` rule silently matches nothing. Excluding the contents and
# re-including the directories is what makes the negations reachable.
artifacts/**
!artifacts/**/
!artifacts/**/ceiling.json
!artifacts/**/*.meta.json
# Training metrics too: they carry the recency/ESS block, the per-epoch history
# and the code sha. R.4's headline numbers -- ess_fraction 0.138, best at epoch
# 3 of 12 -- exist nowhere else. A few KB each.
!artifacts/**/metrics.json

# THE SHIPPED ARTIFACTS (R.6, B2). Three binaries, ~33 MB, tracked by exact path
# rather than by pattern -- everything else under artifacts/ stays ignored.
#
# These were computed on misha under $HOME/scratch, which is PURGED AFTER 60
# DAYS, and `r2_recency` was trained on a laptop and never copied to the
# cluster, so before this commit `model.pt` existed as a single copy on one
# machine. Together the two parquets re-derive the shipped 11.930% ceiling
# without touching a cluster; model.pt is what week 6's serving path loads.
#
# Not tracked by `*.parquet`: that would sweep in every source parquet of every
# run plus the 56 MB two-tower export. Deliberately narrow.
!artifacts/twotower/runs/r2_recency/model.pt
!artifacts/twotower/runs/r2_recency/ann_candidates.parquet
# Spark writes a DIRECTORY here (18 parts). The hidden .crc siblings are Hadoop
# checksums, regenerated on read -- excluded by matching only *.parquet.
!artifacts/candidates_misha_90_50/sources/covisit.parquet/*.parquet
!artifacts/candidates_misha_90_50/sources/covisit.parquet/_SUCCESS

# Job logs. sbatch writes logs/%x-%j.out here and the local runner does the
# same. The directory must EXIST before submit (`mkdir -p logs`), but nothing
# inside it is source.
logs/
.spark-tmp/
